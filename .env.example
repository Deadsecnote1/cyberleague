# Copy to .env (gitignored). Set same vars in n8n → Settings → Variables.

# Required for AI replies
GEMINI_API_KEY=

# Required for Telegram
TELEGRAM_BOT_TOKEN=

# Required for student registry (router auth)
NOTION_API_KEY=
NOTION_USERS_DATABASE_ID=

# Optional: study plan + deadlines workflows
NOTION_STUDENT_DATABASE_ID=
GMAIL_ACCESS_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Demo (no Notion) — set in n8n
# AIVURA_DEMO_MODE=true
# DEMO_ALLOWED_CHAT_IDS=123456789,987654321

# Admin portal → portal/.env
# VITE_ADMIN_PASSWORD=change-me
# VITE_TELEGRAM_BOT_TOKEN=   (optional: Broadcast page only, local)
